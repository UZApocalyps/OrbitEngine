// Package manifest of Story Statistics. `cargo xtask plugins` sets `library`
// to the platform's file name and `min_editor` / `max_editor` to the editor
// version it was built against (a native plugin is tied to one editor build).
(
    id: "orbit.story_stats",
    name: "Story Statistics",
    version: "0.5.1",
    description: "Read-only statistics panel: scenes, steps, words and lines per scene and per character, choices, estimated reading time, voice coverage, CSV export.",
    author: "OrbitEngine contributors",
    library: "orbit_story_stats_plugin.dll",
)
