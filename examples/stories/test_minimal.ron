        entries: {
            "01JBX0T0000000000000000001": "Alice",
            "01JBX0T0000000000000000002": "Bob",
            "01JBX0T0000000000000000003": "Neo-Kyoto, 2087. Rain falls on the megatowers.",
            "01JBX0T0000000000000000004": "Another night, another contract.",
            "01JBX0T0000000000000000005": "Sorry to wake you, Alice. Interested in a job?",
            "01JBX0T0000000000000000006": "Take the job.",
            "01JBX0T0000000000000000007": "Haggle for more.",
            "01JBX0T0000000000000000008": "Fifty credits up front. Do not spend it all at once.",
            "01JBX0T0000000000000000009": "You are pushing it, but fine.",
            "01JBX0T0000000000000000010": "The music fades away.",
            "01JBX0T0000000000000000011": "The end.",
            "01JBX0T0000000000000000012": "In a cramped capsule above the Sprawl, a hacker is wide awake.",
            "01JBX0T0000000000000000013": "Someone knocks at the door. Twice, then once.",
            "01JBX0T0000000000000000014": "Define something.",
            "01JBX0T0000000000000000015": "A prototype chip. Rumour says it holds an AI that woke up.",
            "01JBX0T0000000000000000016": "Who is paying?",
            "01JBX0T0000000000000000017": "Helix. They want it back, quietly.",
            "01JBX0T0000000000000000018": "I am listening.",
            "01JBX0T0000000000000000019": "Then listen well. It will not be easy.",
            "01JBX0T0000000000000000020": "The rain keeps falling on the sleeping city.",
        },
    ),
