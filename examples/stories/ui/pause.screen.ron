(
    ui_version: 1,
    id: "pause",
    pauses_game: true,
    dim_background: true,
    on_cancel: [CloseAll],
    root: (
        kind: Panel(kind: Normal, dir: Vertical),
        layout: (
            width: Fixed(640.0),
            pad: (60.0, 46.0),
            gap: 18.0,
            cross: Stretch,
            anchor: Some((canvas: (0.5, 0.5), pivot: (0.5, 0.5), offset: (0.0, 0.0))),
        ),
        children: [
            (kind: Label(text: Key("ui.pause.title"), center: true), style: Some("heading")),
            (
                kind: Stack(dir: Horizontal),
                layout: (gap: 12.0),
                children: [
                    (kind: Label(text: Literal("¤"))),
                    (kind: Label(text: Bind(Var("credits")))),
                ],
            ),
            (id: "resume", kind: Button(text: Key("ui.menu.resume"), action: [CloseAll])),
            (id: "save", kind: Button(text: Key("ui.menu.save"), action: [OpenSave]), enabled: CanSave),
            (id: "load", kind: Button(text: Key("ui.menu.load"), action: [OpenLoad])),
            (id: "history", kind: Button(text: Key("ui.menu.history"), action: [Open("history")])),
            (id: "prefs", kind: Button(text: Key("ui.menu.preferences"), action: [Open("preferences")])),
            (id: "main", kind: Button(text: Key("ui.menu.main_menu"), action: [ReturnToTitle])),
            (id: "quit", kind: Button(text: Key("ui.menu.quit"), action: [GameQuit]), visible: ShowQuit),
        ],
    ),
)
