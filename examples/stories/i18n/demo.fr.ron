// French translation of demo.ron. Strings 28-31 are deliberately untranslated:
// they fall back to the English source text (see orbit_i18n tests).
(
    lang: "fr",
    name: "Français",
    entries: {
        "01JBX0T0000000000000000001": "Alice",
        "01JBX0T0000000000000000002": "Bob",
        "01JBX0T0000000000000000003": "Une soirée tranquille. La pièce est chaude et la lampe est allumée.",
        "01JBX0T0000000000000000004": "Bonjour ! Bienvenue dans OrbitEngine.",
        "01JBX0T0000000000000000005": "Cette petite histoire est jouée directement depuis un fichier RON.",
        "01JBX0T0000000000000000006": "Quelqu'un frappe à la porte.",
        "01JBX0T0000000000000000007": "Désolé de vous déranger si tard.",
        "01JBX0T0000000000000000008": "Pas du tout, entrez !",
        "01JBX0T0000000000000000009": "J'ai un service à vous demander.",
        "01JBX0T0000000000000000010": "Quel genre de service ?",
        "01JBX0T0000000000000000011": "Quelqu'un a laissé une lourde caisse dans la rue. Pourriez-vous m'aider à la porter ?",
        "01JBX0T0000000000000000012": "Aider Bob à porter la caisse.",
        "01JBX0T0000000000000000013": "Rester à la maison.",
        "01JBX0T0000000000000000014": "Bien sûr, allons-y !",
        "01JBX0T0000000000000000015": "Ensemble, ils descendent la caisse dans l'escalier sombre.",
        "01JBX0T0000000000000000016": "Elle est plus légère qu'elle n'en a l'air.",
        "01JBX0T0000000000000000017": "Attention à la dernière marche.",
        "01JBX0T0000000000000000018": "Merci, je vous en dois une.",
        "01JBX0T0000000000000000019": "Très bien. Je me débrouillerai seul.",
        "01JBX0T0000000000000000020": "Désolée, je suis vraiment occupée ce soir.",
        "01JBX0T0000000000000000021": "Bob la regarde en silence un instant.",
        "01JBX0T0000000000000000022": "Bob s'en va, et la porte se referme derrière lui.",
        "01JBX0T0000000000000000023": "Le lendemain matin, la rue est calme et l'air est froid.",
        "01JBX0T0000000000000000024": "Merci encore pour hier. La caisse est saine et sauve.",
        "01JBX0T0000000000000000025": "Content d'avoir pu aider !",
        "01JBX0T0000000000000000026": "Je suis encore fâché pour hier soir, vous savez.",
        "01JBX0T0000000000000000027": "Je sais. Je suis désolée.",
        "01JBX0T0000000000000000032": "Bon retour ! Vous avez déjà terminé cette histoire au moins une fois.",
    },
)
