(
    ui_version: 7,
    id: "achievements",
    pauses_game: true,
    dim_background: true,
    on_cancel: [Close],
    root: (
        kind: Panel(kind: Normal, dir: Vertical),
        layout: (
            width: Fixed(1400.0),
            height: Fixed(900.0),
            pad: (40.0, 28.0),
            gap: 14.0,
            cross: Stretch,
            anchor: Some((canvas: (0.5, 0.5), pivot: (0.5, 0.5), offset: (0.0, 0.0))),
        ),
        children: [
            (kind: Label(text: Key("ui.achievements.title")), style: Some("heading")),
            (kind: Label(text: Bind(Achievement(Progress)), dim: true)),
            (
                id: "list",
                kind: Repeat(source: Achievements, dir: Grid(2), empty: Some(Key("ui.achievements.empty"))),
                layout: (height: Fill(1.0), gap: 12.0),
                children: [
                    (
                        kind: Panel(kind: Normal, dir: Horizontal),
                        layout: (width: Fixed(640.0), pad: (12.0, 10.0), gap: 14.0, cross: Center),
                        children: [
                            (
                                kind: Image(bind: Some(Achievement(Icon))),
                                layout: (width: Fixed(72.0), height: Fixed(72.0)),
                            ),
                            (
                                kind: Stack(dir: Vertical),
                                layout: (width: Fill(1.0), gap: 4.0),
                                children: [
                                    (kind: Label(text: Bind(Achievement(Title)))),
                                    (kind: Label(text: Bind(Achievement(Description)), dim: true)),
                                    (kind: Label(text: Key("ui.achievements.locked"), dim: true), visible: Not(Unlocked)),
                                ],
                            ),
                        ],
                    ),
                ],
            ),
            (
                kind: Stack(dir: Horizontal),
                children: [
                    (id: "back", kind: Button(text: Key("ui.menu.back"), action: [Close]), layout: (width: Fixed(300.0))),
                ],
            ),
        ],
    ),
)
