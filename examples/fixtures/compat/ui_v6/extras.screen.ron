(
    ui_version: 6,
    id: "extras",
    pauses_game: true,
    on_cancel: [Close],
    root: (
        id: "frame",
        kind: Panel(kind: Normal, dir: Vertical),
        style: Some("card"),
        layout: (
            width: Fixed(1100.0),
            height: Fit,
            pad: (32.0, 32.0),
            gap: 16.0,
            anchor: Some((canvas: (0.5, 0.5), pivot: (0.5, 0.5), offset: (0.0, 0.0))),
        ),
        children: [
            (id: "logo", kind: Image(asset: Some("assets/ui/logo.png")), layout: (width: Fixed(300.0), height: Fixed(120.0))),
            (
                id: "gallery",
                kind: Repeat(source: Gallery([]), dir: Grid(4)),
                children: [
                    (kind: Image(bind: Some(Item)), visible: Item),
                    (kind: Label(text: Literal("?"), center: true), visible: Not(Item)),
                ],
            ),
            (
                id: "back",
                kind: Button(text: Key("ui.back"), action: [Close]),
                style: Some("flat"),
                overrides: (text_colors: (hover: Some((255, 220, 120, 255)))),
            ),
        ],
    ),
)
