(
    ui_version: 6,
    id: "replay",
    pauses_game: true,
    dim_background: true,
    on_cancel: [Close],
    root: (
        kind: Panel(kind: Normal, dir: Vertical),
        layout: (
            width: Fixed(1400.0),
            height: Fixed(900.0),
            pad: (40.0, 28.0),
            gap: 14.0,
            cross: Stretch,
            anchor: Some((canvas: (0.5, 0.5), pivot: (0.5, 0.5), offset: (0.0, 0.0))),
        ),
        children: [
            (kind: Label(text: Key("ui.replay.title")), style: Some("heading")),
            (
                id: "scenes",
                kind: Repeat(source: ReplayScenes([]), dir: Grid(2), empty: Some(Key("ui.replay.empty"))),
                layout: (height: Fill(1.0), gap: 12.0),
                children: [
                    (kind: Button(text: Bind(Item), action: [ReplayScene(Item)]), layout: (width: Fixed(640.0))),
                ],
            ),
            (
                kind: Stack(dir: Horizontal),
                children: [
                    (id: "back", kind: Button(text: Key("ui.menu.back"), action: [Close]), layout: (width: Fixed(300.0))),
                ],
            ),
        ],
    ),
)
