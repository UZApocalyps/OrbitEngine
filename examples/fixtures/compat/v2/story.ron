        entries: {
            "01JBX0T0000000000000000001": "Alice",
            "01JBX0T0000000000000000002": "Bob",
            "01JBX0T0000000000000000003": "A quiet evening. The room is warm and the lamp is on.",
            "01JBX0T0000000000000000004": "Hello! Welcome to OrbitEngine.",
            "01JBX0T0000000000000000005": "This little story is played straight from a RON file.",
            "01JBX0T0000000000000000006": "Someone knocks at the door.",
            "01JBX0T0000000000000000007": "Sorry to bother you so late.",
            "01JBX0T0000000000000000008": "Not at all, come in!",
            "01JBX0T0000000000000000009": "I need a favour.",
            "01JBX0T0000000000000000010": "What kind of favour?",
            "01JBX0T0000000000000000011": "Somebody left a heavy box in the street. Could you help me carry it?",
            "01JBX0T0000000000000000012": "Help Bob carry the box.",
            "01JBX0T0000000000000000013": "Stay home.",
            "01JBX0T0000000000000000014": "Of course, let's go!",
            "01JBX0T0000000000000000015": "Together they carry the box down the dark stairs.",
            "01JBX0T0000000000000000016": "It is lighter than it looks.",
            "01JBX0T0000000000000000017": "Careful with the last step.",
            "01JBX0T0000000000000000018": "Thank you, I owe you one.",
            "01JBX0T0000000000000000019": "Fine. I will manage on my own.",
            "01JBX0T0000000000000000020": "Sorry, I am really busy tonight.",
            "01JBX0T0000000000000000021": "Bob looks at her in silence for a moment.",
            "01JBX0T0000000000000000022": "Bob leaves, and the door closes behind him.",
            "01JBX0T0000000000000000023": "The next morning, the street is quiet and the air is cold.",
            "01JBX0T0000000000000000024": "Thanks again for yesterday. The box is safe and sound.",
            "01JBX0T0000000000000000025": "Glad I could help!",
            "01JBX0T0000000000000000026": "I am still annoyed about last night, you know.",
            "01JBX0T0000000000000000027": "I know. I am sorry.",
            "01JBX0T0000000000000000028": "Anyway, do you hear that melody?",
            "01JBX0T0000000000000000029": "Yes, it is the theme of this very story.",
            "01JBX0T0000000000000000030": "The music fades away.",
            "01JBX0T0000000000000000031": "Thank you for playing the OrbitEngine demo!",
        },
    ),
    assets: (assets: [
