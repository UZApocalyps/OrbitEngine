        entries: {
            "01TPX0T0000000000000000001": "Mira",
            "01TPX0T0000000000000000002": "Jun",
            "01TPX0T0000000000000000003": "Dawn over the harbour town. The ferry leaves in one hour.",
            "01TPX0T0000000000000000004": "I almost did not come. But here I am.",
            "01TPX0T0000000000000000005": "Mira! I saved you a seat by the window.",
            "01TPX0T0000000000000000006": "Thank her warmly.",
            "01TPX0T0000000000000000007": "Say nothing and sit down.",
            "01TPX0T0000000000000000008": "Thanks, Jun. It means a lot.",
            "01TPX0T0000000000000000009": "Always. Let us make this trip a good one.",
            "01TPX0T0000000000000000010": "...",
            "01TPX0T0000000000000000011": "You are quiet today. That is fine too.",
            "01TPX0T0000000000000000012": "Night on the island. The lanterns are lit.",
            "01TPX0T0000000000000000013": "I am glad you came along, Mira.",
            "01TPX0T0000000000000000014": "Jun smiles. Today the two of you are closer than ever.",
            "01TPX0T0000000000000000015": "Jun smiles politely. There is still time to get to know each other.",
            "01TPX0T0000000000000000016": "The end. Edit this story, or start your own.",
        },
    ),
