(
    ui_version: 4,
    id: "load",
    pauses_game: true,
    dim_background: true,
    on_cancel: [Close],
    root: (
        kind: Panel(kind: Normal, dir: Vertical),
        layout: (
            width: Fixed(1760.0),
            height: Fixed(980.0),
            pad: (40.0, 28.0),
            gap: 14.0,
            cross: Stretch,
            anchor: Some((canvas: (0.5, 0.5), pivot: (0.5, 0.5), offset: (0.0, 0.0))),
        ),
        children: [
            (kind: Label(text: Key("ui.load.title")), style: Some("heading")),
            (id: "slots", kind: SaveSlots(mode: Load, columns: 3, rows: 2)),
            (kind: Stack(dir: Vertical), layout: (height: Fill(1.0))),
            (
                kind: Stack(dir: Horizontal),
                children: [
                    (id: "back", kind: Button(text: Key("ui.menu.back"), action: [Close]), layout: (width: Fixed(300.0))),
                ],
            ),
        ],
    ),
)
